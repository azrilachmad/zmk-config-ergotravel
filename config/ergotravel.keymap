#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // LAYER 0 (Default Layer)
        default_layer {
            bindings = <
                &kp ESC   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp MINUS   &kp EQUAL   &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                &kp TAB   &kp A     &kp S     &kp D     &kp F     &kp G     &kp LBKT    &kp RBKT    &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp RET     &kp RET     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RET
                &kp LCTRL &kp LGUI  &kp LALT  &mo 2     &kp SPACE &mo 1                             &mo 1     &kp SPACE &kp LEFT  &kp UP    &kp DOWN  &kp RIGHT
            >;
        };

        // LAYER 1 (Lower / Media & Function Layer)
        lower_layer {
            bindings = <
                &kp TILDE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp PG_UP   &kp C_VOL_UP &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
                &none     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp PG_DN   &kp C_VOL_DN &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp PSCRN
                &none     &none     &none     &none     &none     &kp F10   &kp RET     &kp RET      &kp F12   &none     &none     &none     &none     &none
                &none     &none     &none     &none     &kp SPACE &none                              &trans    &kp SPACE &kp C_PREV &kp C_MUTE &kp C_PP &kp C_NEXT
            >;
        };

        // LAYER 2 (Raise / Numpad & Symbols Layer)
        raise_layer {
            bindings = <
                &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &trans      &trans      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
                &trans    &kp N4    &kp N5    &kp N6    &kp PLUS  &trans    &trans      &trans      &trans    &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &trans
                &kp RET   &kp N7    &kp N8    &kp N9    &kp MINUS &trans    &trans      &trans      &trans    &kp NON_US_HASH &kp NON_US_BSLH &kp C_MUTE &trans &kp BSLH
                &trans    &kp COMMA &kp N0    &trans    &mo 3     &kp BSPC                          &trans    &trans    &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP &kp C_PP
            >;
        };

        // LAYER 3 (System & Reset Layer)
        system_layer {
            bindings = <
                &kp LC(LS(ESC)) &trans &trans &trans   &trans    &trans    &trans      &trans      &trans    &none     &none     &none     &none     &kp LC(LA(DEL))
                &trans    &trans    &trans    &trans    &trans    &trans    &trans      &trans      &trans    &none     &none     &none     &none     &none
                &trans    &trans    &trans    &trans    &trans    &trans    &trans      &trans      &trans    &trans    &trans    &trans    &trans    &none
                &trans    &trans    &trans    &trans    &trans    &trans                            &trans    &trans    &trans    &trans    &trans    &bootloader
            >;
        };
    };
};