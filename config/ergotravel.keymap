#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // LAYER 0 (Default Layer)
        default_layer {
            bindings = <
                &kp ESC   &kp Q     &kp W     &kp E     &kp R     &kp T                         &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                &kp TAB   &kp A     &kp S     &kp D     &kp F     &kp G                         &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B                         &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RET
                &kp LCTRL &kp LGUI  &kp LALT  &mo 2     &kp SPACE &mo 1                         &mo 1     &kp SPACE &kp LEFT  &kp UP    &kp DOWN  &kp RIGHT
            >;
        };

        // LAYER 1 (Lower / Media & Number Layer)
        lower_layer {
            bindings = <
                &kp GRAVE &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PG_UP                      &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp DEL
                &none     &kp F1    &kp F2    &kp F3    &kp F4    &kp PG_DN  &kp C_VOL_UP        &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp PSCRN
                &none     &none     &none     &none     &none     &kp F10    &kp C_VOL_DN        &kp F12   &none     &none     &none     &none     &none
                &none     &none     &none     &none     &kp SPACE &none                          &kp C_PREV &kp C_MUTE &kp C_PP &kp C_NEXT &none &none
            >;
        };
    };
};